# Supabase → Project Settings → API bölümünden kopyala.
# Bu iki değer TARAYICIYA gider, gizli değildir; güvenlik RLS ile sağlanır.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Sitenin adresi (e-posta doğrulama bağlantıları buraya döner)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# DİKKAT: service_role anahtarını BURAYA YAZMA. O anahtar bütün güvenlik
# kurallarını atlar. Sadece sunucu tarafı işler için, ayrı ve gizli tutulur.
